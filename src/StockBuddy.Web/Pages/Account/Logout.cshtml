@page
@model StockBuddy.Web.Pages.Account.LogoutModel
@{ ViewData["Title"] = "Sign out"; }
<h1>All done for now?</h1>
<p>Your saved inventory will be here when you return. Signing out ends your sessions on all devices.</p>
<form method="post">
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <button type="submit">Sign out everywhere</button>
</form>
<p><a href="/">Back to inventory</a></p>
